# ═══════════════════════════════════════════════════
#  Environment Variables — Portfolio RAG Chatbot
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════

# --- NVIDIA NIM API ---
# Get your key at: https://build.nvidia.com
# Used by both server.js (LLM + embeddings) and seed.js (embeddings only)
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- Supabase ---
# Find these in your Supabase project: Settings → API
# Use the SERVICE_ROLE key (not anon) — it bypasses RLS, needed for seeding.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# --- Backend Port ---
# The Express API server listens on this port.
PORT=3001

# --- Frontend (Vite exposes VITE_ prefixed vars to the browser) ---
# Points the chat widget at your local Express server during development.
# For production, change this to your deployed API URL.
VITE_CHAT_API_URL=http://localhost:3001/api/chat
